# Copy to .env and adjust. Never commit .env.
APP_NAME="Tag Platform"
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://tagplatform:devpassword@localhost:5432/tagplatform

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Local email goes to Mailpit (http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Tag Platform <no-reply@localhost>"
# Alternative for tests/no Docker: write emails as JSON files instead of SMTP
# MAIL_OUTBOX_DIR=./.mail-outbox

# Reverse proxy IPs (production only), comma-separated
TRUSTED_PROXIES=
AUTH_RATE_LIMIT=on

# Object storage (milestone 4)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=tagplatform
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey123

# Secrets vault (milestone 3)
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token

# Disposable database for integration tests (wiped on every run)
TEST_DATABASE_URL=postgres://tagplatform:devpassword@localhost:5432/tagplatform_test
