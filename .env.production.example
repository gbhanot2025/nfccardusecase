# Copy to .env.production on the server (never commit it). See docs/runbook.md.
APP_NAME="Tag Platform"
APP_DOMAIN=tags.example.com
APP_BASE_URL=https://tags.example.com
ACME_EMAIL=ops@example.com

# openssl rand -base64 48   (each one different)
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
# Keeps server actions working across deploys: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Real SMTP provider (required in production)
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="Tag Platform <no-reply@tags.example.com>"

# Docker network range Caddy connects from (default compose network)
TRUSTED_PROXIES=172.16.0.0/12
AUTH_RATE_LIMIT=on

# OpenBao token with read access to secret/data/ntag424/master-key only (see runbook)
OPENBAO_TOKEN=

# Object storage (milestone 4 uploads). Use real keys and a custom s3.json via S3_CONFIG_FILE.
S3_REGION=us-east-1
S3_BUCKET=tagplatform
S3_ACCESS_KEY=
S3_SECRET_KEY=

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
